# Copy this file to .env and fill in your values.

# LLM provider: "openai" for real GPT calls, "mock" for keyword-based simulation
LLM_PROVIDER=openai

# Your OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=OPENAI_API_KEY

# Conversational model for intent classification and Telly responses
OPENAI_MODEL=gpt-4.1-mini

# Voice models for speech-to-text, text-to-speech, and browser realtime sessions
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# JWT signing secret — change this in production
JWT_SECRET=please-set-a-secure-jwt-secret
